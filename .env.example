# ============================================================
# APEX SCOUT - Configuration (.env.example)
# Kopyalayın: cp .env.example .env  ->  ardından değerleri doldurun
# ============================================================

# ============ OKX DEMO ONLY (ZORUNLU) ============
# Sadece DEMO hesap çalışır! Gerçek hesap engellenir.
OKX_API_KEY=your_demo_api_key_here
OKX_API_SECRET=your_demo_api_secret_here
OKX_PASSPHRASE=your_demo_passphrase_here
OKX_DEMO_TRADING=true        # ZORUNLU: "true" olmalı, aksi takdirde sistem başlatmaz
OKX_BASE_URL=https://www.okx.com

# ============ SCANNER AYARLARI ============
SCAN_INTERVAL_SECONDS=60                    # Tarama aralığı (saniye)
DEXSCREENER_BASE_URL=https://api.dexscreener.com
PUMPFUN_BASE_URL=https://frontend-api.pump.fun
MIN_LIQUIDITY_USD=5000                      # Minimum likidite (USD)
MAX_TOKEN_AGE_HOURS=2                       # Maksimum token yaşı (saat)
MIN_VOLUME_24H=1000                         # Minimum 24h hacim (USD)

# ============ DECISION / SKORLAMA ============
MIN_SCORE_TO_TRADE=70                       # İşlem yapılacak minimum skor (0-100)
WATCH_THRESHOLD=50                          # İzleme eşiği (altında SKIP)
# Skor ağırlıkları (toplam 1.0 olmalı)
SCORING_WEIGHTS_LIQUIDITY=0.25              # Likidite derinliği ağırlığı
SCORING_WEIGHTS_VOLUME=0.20                 # Hacim ağırlığı
SCORING_WEIGHTS_AGE=0.15                    # Token yaşı ağırlığı
SCORING_WEIGHTS_MCAP=0.15                   # Market cap ağırlığı
SCORING_WEIGHTS_MINT_FREEZE=0.10            # Mint/Freeze yetkisi ağırlığı
SCORING_WEIGHTS_HOLDER_DIST=0.15            # Holder dağılımı ağırlığı

# ============ RISK YÖNETİMİ ============
MAX_OPEN_POSITIONS=4                        # Maksimum eşzamanlı açık pozisyon
MAX_PORTFOLIO_RISK_PCT=35                   # Portföyün max risk altındaki oranı (%)
POSITION_SIZE_PCT=10                        # İşlem başına pozisyon büyüklüğü (%)
STOP_LOSS_PCT=15                            # Stop-Loss yüzdesi (%)
TRAILING_STOP_PCT=10                        # Trailing Stop yüzdesi (%)
# Kademeli Take-Profit: [{"profit_pct": 25, "sell_pct": 40}, {"profit_pct": 45, "sell_pct": 40}, {"profit_pct": 70, "sell_pct": 20}]
TAKE_PROFIT_TIERS=[{"profit_pct": 25, "sell_pct": 40}, {"profit_pct": 45, "sell_pct": 40}, {"profit_pct": 70, "sell_pct": 20}]
BLACKLIST_DURATION_HOURS=3                  # SL yiyen token blacklist süresi (saat)
TRADE_COOLDOWN_SECONDS=30                   # İşlemler arası minimum bekleme (saniye)

# ============ DASHBOARD ============
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SECONDS=10                # Dashboard yenileme aralığı

# ============ SISTEM / LOG / DB ============
LOG_LEVEL=INFO                              # DEBUG, INFO, WARNING, ERROR
LOG_ROTATION=10 MB                          # Log dosyası boyutu
LOG_RETENTION=7 days                        # Log saklama süresi
DB_URL=sqlite:///data/apex_scout.db         # Veritabanı URL
HEARTBEAT_INTERVAL=30                       # Sağlık kontrolü aralığı (saniye)
MAX_RETRIES=3                               # Maksimum yeniden deneme
RETRY_BACKOFF_BASE=2                        # Exponential backoff tabanı